<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <WebView
        android:id="@+id/loginWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/loginProgressBar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary" />

    <!-- Top instructions & manual confirm button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#EE1E1E1E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖱️ Dùng phím mũi tên di chuyển chuột, bấm OK để click"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Đã quét QR xong? App sẽ TỰ ĐỘNG LƯU! (Hoặc bấm phím [BACK] để lưu ngay)"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDoneLogin"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/btn_tv_selector"
            android:focusable="true"
            android:clickable="true"
            android:paddingHorizontal="20dp"
            android:text="✅ Lưu &amp; Xong"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Virtual Mouse Cursor Overlay -->
    <ImageView
        android:id="@+id/ivVirtualCursor"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/cursor_pointer"
        android:elevation="10dp"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
